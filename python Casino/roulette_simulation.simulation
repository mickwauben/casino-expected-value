import random, csv
roulette=[]     
    
with open("roulette.csv", mode="r", encoding="utf-8") as bestand:
    reader = csv.reader(bestand, delimiter=";")
    for row in reader:
        roulette.append(row)
amount = 1000000
tot_red=0
tot_green=0
tot_black=0
tot_even=0
tot_odd=0
tot_number=0
        
for i in range (amount):
    box=random.choice(roulette)
    number=int(box[0])
    color= box[1]
    EvenOdd= box[2]
    if color == 'rood':
        tot_red= tot_red+1
    else:
        tot_red= tot_red-1
    if color == 'zwart':
        tot_black= tot_black+1
    else:
        tot_black= tot_black-1
    if color == 'groen':
        tot_green= tot_green+35
    else:
        tot_green= tot_green-1
    if EvenOdd== 'even':
        tot_even=tot_even+1
    else:
        tot_even= tot_even-1
    if EvenOdd == 'oneven':
        tot_odd= tot_odd+1
    else:
        tot_odd= tot_odd-1
    if number == 17:
        tot_number= tot_number+35
    else:
        tot_number= tot_number-1
print('red:', tot_red/amount)
print('black:', tot_black/amount)
print('green:', tot_green/amount)
print('even:', tot_even/amount)
print('odd:', tot_odd/amount)
print('number:', tot_number/amount)